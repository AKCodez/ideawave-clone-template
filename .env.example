# Copy to .env and fill in what you have. Every key is optional: missing
# credentials turn a feature off with a readable message, they never crash the
# app, and `npm run verify` passes with this file empty.

# Pooled Neon connection string the app queries through the Prisma adapter.
DATABASE_URL=""
# Unpooled Neon connection string, used only by prisma migrate.
DIRECT_URL=""

# Random 32+ char string that signs session cookies. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Origin Better Auth signs callbacks against. Leave blank to fall back to NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=""
# Public origin of this deployment, used in emails and Stripe redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Which curated palette renders: ember, slate or meadow.
# Read at build time, so changing it needs a rebuild, not just a restart.
APP_PALETTE="ember"
# Set to 1 to show the demo banner and seeded-credentials notice.
DEMO_MODE=""

# Google OAuth. Both must be set for the Google button to appear.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe secret key. Its presence is what enables billing.
STRIPE_SECRET_KEY=""
# Signing secret for /api/webhooks/stripe, from the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=""
# The one recurring price the upgrade button checks out.
STRIPE_PRICE_ID=""
# Publishable key, safe to expose in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend API key. Its presence is what enables real email sending.
RESEND_API_KEY=""
# Verified sender address for transactional email.
RESEND_FROM="onboarding@resend.dev"
